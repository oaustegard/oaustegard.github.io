{
  "name": "PDF to Webpage",
  "short_name": "PDF2Page",
  "description": "Convert a PDF into a mobile-readable webpage, entirely in your browser.",
  "start_url": "pdf-to-webpage.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2456b3",
  "icons": [
    {
      "src": "/images/pdf-to-webpage-icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/images/pdf-to-webpage-icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/images/pdf-to-webpage-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "pdf-to-webpage-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "pdf",
          "accept": [
            "application/pdf",
            "application/octet-stream",
            ".pdf"
          ]
        }
      ]
    }
  }
}
